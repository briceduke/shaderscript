{
  "name": "shaderscript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "checks": "bun run --cwd packages/checks check",
    "checks:structure": "bun run --cwd packages/checks check:structure",
    "test:compile": "bun run --cwd packages/shaderscript test:compile",
    "test:harness": "bun run --cwd packages/shaderscript test:harness"
  }
}